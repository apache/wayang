<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <artifactId>wayang-api</artifactId>
        <groupId>org.apache.wayang</groupId>
        <version>1.1.2-SNAPSHOT</version>
    </parent>

    <artifactId>wayang-api-jdbc</artifactId>
    <name>Wayang API JDBC</name>
    <description>
        JDBC driver for Apache Wayang that allows external tools to connect
        to Wayang as if it were a relational database.
    </description>

    <dependencies>
        <!-- Wayang SQL API - this is what we delegate SQL execution to -->
        <dependency>
            <groupId>org.apache.wayang</groupId>
            <artifactId>wayang-api-sql</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Wayang Core -->
        <dependency>
            <groupId>org.apache.wayang</groupId>
            <artifactId>wayang-core</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Wayang Java Platform -->
        <dependency>
            <groupId>org.apache.wayang</groupId>
            <artifactId>wayang-java</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Wayang Basic -->
        <dependency>
            <groupId>org.apache.wayang</groupId>
            <artifactId>wayang-basic</artifactId>
            <version>${project.version}</version>
        </dependency>


        <!-- JSON for test setup -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JSON simple for ModelParser -->
        <dependency>
            <groupId>com.googlecode.json-simple</groupId>
            <artifactId>json-simple</artifactId>
            <version>1.1.1</version>
            <scope>test</scope>
        </dependency>

        <!-- Testing -->
        <!-- Testing -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Exclude old junit 4.10 that conflicts with vintage engine -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>

        
    </dependencies>

   <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>--add-opens=java.base/java.io=ALL-UNNAMED --add-opens=java.base/java.lang=ALL-UNNAMED</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>